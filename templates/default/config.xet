<?xml version="1.0" encoding="UTF-8"?>
<?xml-model href="../../../doc/etemplate2/etemplate2.0.rng" type="application/xml" schematypens="http://relaxng.org/ns/structure/1.0"?>
<!DOCTYPE overlay PUBLIC "-//EGroupware GmbH//eTemplate 2.0//EN" "https://www.egroupware.org/etemplate2.0.dtd">
<overlay>
	<et2-template  id="rag.config" template="" lang="" group="0" version="16.1">
		<grid width="100%" class="admin-config egwGridView_grid">
			<columns>
				<column width="40%"/>
				<column/>
			</columns>
			<rows>
				<row>
					<et2-description  value="General configuration" span="all" class="subHeader"></et2-description>
				</row>
				<row>
					<et2-description  value="Applications to add to fulltext-index"></et2-description>
					<et2-select  id="newsettings[fulltext_apps]" multiple="true" placeholder="All supported"></et2-select>
				</row>
				<row>
					<et2-description  value="Applications for RAG / to calculate embeddings for"></et2-description>
					<et2-select  id="newsettings[rag_apps]" multiple="true" placeholder="All supported"></et2-select>
				</row>
				<row>
					<et2-description  value="URL of OpenAI compatible API"></et2-description>
					<et2-url  id="newsettings[url]" class="et2_required" placeholder="http://172.17.0.1:11434/v1 {leave empty to disable RAG}" validator="/^https?:\/\/.*\/v1$/" trailingSlash="false"></et2-url>
				</row>
				<row>
					<et2-description  value="API Key"></et2-description>
					<et2-password  id="newsettings[api_key]"></et2-password>
				</row>
				<row>
					<et2-description></et2-description>
					<et2-vbox>
						<et2-details  summary="{General configuration}: Ollama" accordionGroup="notes">
							<et2-description  label="URL:" value="http://172.17.0.1:11435/v1"></et2-description>
							<et2-description  value="Please note: Ollama must be bound to all interfaces, NOT just localhost!"></et2-description>
							<et2-description  label="Model:" value="bge-m3"></et2-description>
						</et2-details>
						<et2-details  summary="{General configuration}: EGroupware AI Proxy" accordionGroup="notes">
							<et2-description  label="URL:" value="https://ai-proxy.egroupware.org/v1"></et2-description>
							<et2-description  label="Model:" value="bge-m3"></et2-description>
						</et2-details>
						<et2-details  summary="{General configuration}: IONOS AI Hub" accordionGroup="notes">
							<et2-description  label="URL:" value="https://openai.inference.de-txl.ionos.com/v1"></et2-description>
							<et2-description  label="Model:" value="BAAI/bge-m3"></et2-description>
						</et2-details>
					</et2-vbox>
				</row>
				<row>
					<et2-description  value="Embedding configuration" span="all" class="subHeader"></et2-description>
				</row>
				<row>
					<et2-description  value="Model to use"></et2-description>
					<et2-hbox>
						<et2-textbox  id="newsettings[embedding_model]" placeholder="bge-m3"></et2-textbox>
						<et2-description  label="Currently only embedding models with 1024 dimensions, like bge-m3 are supported!"></et2-description>
					</et2-hbox>
				</row>
				<row>
					<et2-description  value="Chunk size"></et2-description>
					<et2-hbox>
						<et2-number  id="newsettings[chunk_size]" min="200" placeholder="1500" precision="0"></et2-number>
						<et2-description  label="In characters, incl. the context prefixed to every chunk. Changing it re-embeds everything!"></et2-description>
					</et2-hbox>
				</row>
				<row>
					<et2-description  value="Chunk overlap"></et2-description>
					<et2-number  id="newsettings[chunk_overlap]" min="0" placeholder="100" precision="0"></et2-number>
				</row>
				<row>
					<et2-description  value="Minimize chunks e.g. concatenate title and description"></et2-description>
					<et2-select  id="newsettings[minimize_chunks]">
						<option value="">yes</option>
						<option value="no">No</option>
					</et2-select>
				</row>
				<row>
					<et2-description  value="Search configuration" span="all" class="subHeader"></et2-description>
				</row>
				<row>
					<et2-description  value="Max. distance of a semantic match"></et2-description>
					<et2-hbox>
						<et2-number id="newsettings[max_distance]" min="0.05" max="2" precision="2" placeholder="0.4"></et2-number>
						<et2-description label="0 = identical, 2 = opposite meaning, default 0.4"></et2-description>
					</et2-hbox>
				</row>
				<row>
					<et2-description  value="Number of results for the search in the applications' lists"></et2-description>
					<et2-number id="newsettings[search_depth]" min="50" max="5000" precision="0" placeholder="200"></et2-number>
				</row>
				<row>
					<et2-description  value="Reranking the best matches (optional)" span="all" class="subHeader"></et2-description>
				</row>
				<row>
					<et2-description  value="Model to rerank the best matches"></et2-description>
					<et2-hbox>
						<et2-textbox id="newsettings[rerank_model]" placeholder="bge-reranker-v2-m3"></et2-textbox>
						<et2-description label="Leave empty to switch the reranking off. A cross-encoder judges query and text together and orders the matches better, but it adds a request per search."></et2-description>
					</et2-hbox>
				</row>
				<row>
					<et2-description  value="URL of the rerank endpoint"></et2-description>
					<et2-hbox>
						<et2-textbox id="newsettings[rerank_url]"></et2-textbox>
						<et2-description label="Leave empty to use the URL above"></et2-description>
					</et2-hbox>
				</row>
				<row>
					<et2-description  value="API of the rerank endpoint"></et2-description>
					<et2-select id="newsettings[rerank_api]">
						<option value="">llama.cpp / vLLM / Jina (/v1/rerank)</option>
						<option value="tei">HuggingFace TEI (/rerank)</option>
					</et2-select>
				</row>
				<row>
					<et2-description  value="How many matches to rerank"></et2-description>
					<et2-hbox>
						<et2-number id="newsettings[rerank_depth]" min="2" max="500" precision="0" placeholder="50"></et2-number>
						<et2-description label="More candidates give a better order, but take longer: on a CPU about 1-3 seconds for 50."></et2-description>
					</et2-hbox>
				</row>
				<row>
					<et2-description  value="Minimum score of the reranker"></et2-description>
					<et2-hbox>
						<et2-number id="newsettings[rerank_min_score]" min="0" max="1" precision="2" placeholder="0"></et2-number>
						<et2-description label="Matches scored below are dropped, 0 keeps all of them"></et2-description>
					</et2-hbox>
				</row>
				<row>
					<et2-description  value="Timeout of the rerank endpoint"></et2-description>
					<et2-number id="newsettings[rerank_timeout]" min="1" max="30" precision="0" placeholder="3"></et2-number>
				</row>
				<row>
					<et2-description  value="Async Job Settings (Cron Schedule): Leave empty to use defaults."/>
					<et2-hbox>
						<et2-textbox  width="14%" id="newsettings[async_year]" label="Year"/>
						<et2-textbox  width="14%" id="newsettings[async_month]" label="Month"/>
						<et2-textbox  width="14%" id="newsettings[async_day]" label="Day"/>
						<et2-textbox  width="14%" id="newsettings[async_dow]" label="DoW" statustext="Weekday 0-6, 0=Sun"/>
						<et2-textbox  width="14%" id="newsettings[async_hour]" label="Hour" />
						<et2-textbox  width="14%" id="newsettings[async_min]" label="Minute" statustext="Default: */5 (=every 5 minutes)" placeholder="*/5"/>
						<et2-textbox  width="14%" id="newsettings[async_maxruntime]" label="Max. Runtime" placeholder="285" statustext="Stop calculating embeddings after this time (in seconds). Default: 285 (4min:45sec)"/>
					</et2-hbox>
				</row>
				<row>
					<et2-description  value="Last errors of RAG's async job" span="all" class="subHeader"></et2-description>
				</row>
				<row>
					<!-- hack to get summary="@newsettings[rag_last_error_time]" working/propagated: id="newsettings[rag_last_error_time]" -->
					<et2-details  summary="@newsettings[rag_last_error_time]" span="all">
						<et2-description  id="newsettings[rag_last_errors]"></et2-description>
					</et2-details>
				</row>
			</rows>
		</grid>
	</et2-template>
</overlay>
